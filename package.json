{
  "name": "realbook-strudel",
  "version": "0.1.0",
  "private": true,
  "description": "Editable library of authorized lead sheets for Strudel.",
  "type": "module",
  "scripts": {
    "dev": "vite --config apps/web/vite.config.ts",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "preview": "vite preview --config apps/web/vite.config.ts",
    "tui": "python3 tools/tui.py",
    "tui:check": "python3 tools/tui.py --check",
    "tui:legacy": "vite-node --config vite.tui.config.ts tools/tui.tsx",
    "tui:legacy:check": "vite-node --config vite.tui.config.ts tools/tui.tsx --check",
    "validate:songs": "tsx tools/validate-songs.ts"
  },
  "keywords": [
    "strudel",
    "jazz",
    "live-coding",
    "tui"
  ],
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@strudel/web": "1.3.0",
    "ink": "^8.0.0",
    "ink-text-input": "^6.0.0",
    "node-web-audio-api": "^2.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "tsx": "^4.0.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vite-node": "^6.0.0"
  }
}
